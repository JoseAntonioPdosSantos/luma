# Backend configuration. Copy to .env and adjust for local development.
# See flashcard_learning_system_agent.md section 22 for details.

APP_ENV=development
HTTP_PORT=8080
MONGODB_URI=mongodb://mongo:27017
MONGODB_DATABASE=flashcard
# Required in any environment other than "development".
SESSION_SECRET=
COOKIE_SECURE=false
MAX_AUDIO_SIZE_BYTES=10485760
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend configuration.
VITE_API_BASE_URL=http://localhost:8080

# Backups (docker compose "backup" service; see docs/BACKUP.md).
# Time zone for BACKUP_HOUR, hour of day (0-23) after which the daily backup
# is taken, how many backups to keep, and the user/group that owns the files
# in ./backups (run `id -u` / `id -g` to find yours).
BACKUP_TZ=America/Campo_Grande
BACKUP_HOUR=3
BACKUP_KEEP=1
BACKUP_UID=1000
BACKUP_GID=1000
